import pandas as pd

# read the dataset pumpkins CVS file
pumpkins = pd.read_csv('../data/US-pumpkins.csv')

# filter out any rows that dont use price per bushel
pumpkins = pumpkins[pumpkins['Package'].str.contains('bushel', case=True, regex=True)]
pumpkins.head()

# count how many empty cells in each column
pumpkins.isnull().sum()

# define cols we want to keep
new_columns = ['Package', 'Month', 'Low Price', 'High Price', 'Date']

# drop all the other columns 
pumpkins = pumpkins.drop([c for c in pumpkins.columns if c not in new_columns], axis=1)

# Get an average between low and high price for the base pumpkin price
price = (pumpkins['Low Price'] + pumpkins['High Price']) / 2

# get the month from date column
month = pd.DatetimeIndex(pumpkins['Date']).month

# create a new date frame with these new columns
new_pumpkins = pd.DataFrame({'Month': month, 'Package': pumpkins['Package'], 'Low Price': pumpkins['Low Price'],'High Price': pumpkins['High Price'], 'Price': price})
